# Optional server-side Google Gemini key. Never expose this value in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated development frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional SQLite database location (defaults to backend/scam_hunter.db)
SCAM_HUNTER_DB=
# Set true only when you explicitly want local reports to retain submitted content.
STORE_SUBMITTED_CONTENT=false
